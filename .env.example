# Template biến môi trường cho QuickQR Studio
# Sao chép file này thành .env.local để ghi đè trên máy cá nhân
VITE_APP_ENV=development
VITE_APP_TITLE=QuickQR Studio
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5173/api
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGS=true
VITE_STORAGE_PREFIX=quickqr_dev_
VITE_DEFAULT_QR_URL=https://quickqr.io
